#!/usr/bin/env bash
set -euo pipefail

service="truthviz"
container_port=3000

usage() {
    cat <<'EOF'
Usage: ./dev COMMAND

Commands:
  full-setup  Build, start, and wait for the application to become healthy
  build       Build the development image
  test        Run the unit-test suite in a temporary development container
  start       Build and start the application in the background
  shell       Open a shell in the running application container
  logs        Show recent application logs
  url         Print the current browser URL
  stop        Stop and remove the development containers
EOF
}

get_port() {
    docker compose port "$service" "$container_port" |
        head -n1 |
        sed 's/.*://'
}

get_url() {
    port="$(get_port)"
    echo "http://localhost:${port}"
}

case "${1:-}" in
  full-setup)
    docker compose up --build -d --wait
    echo
    echo "Application running at:"
    get_url
    ;;
  build)
    docker compose build
    ;;
  test)
    docker compose run --rm "$service" bash -lc '
      if [ ! -x venv/bin/python ]; then
        echo "Run ./dev full-setup once to create the development environment." >&2
        exit 1
      fi
      venv/bin/python -m unittest discover -s tests -v
    '
    ;;
  start)
    docker compose up -d --build
    ;;
    shell)
        docker compose exec "$service" bash
        ;;
  logs)
    docker compose logs --tail=200 "$service"
    ;;
  url)
    get_url
    ;;
  stop)
    docker compose down
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
