#!/usr/bin/env bash
# Public local viewer CLI. JSON viewing needs only Python's standard library.
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${TRUTHVIZ_PYTHON:-}" ]; then
    python_bin="$TRUTHVIZ_PYTHON"
elif [ -x "$project_root/venv/bin/python" ]; then
    python_bin="$project_root/venv/bin/python"
else
    python_bin=python3
fi
# A fresh CMSSW container shell may not yet have scram on PATH. JSON viewing
# remains independent of CMS; ROOT conversion needs the same bootstrap as run.sh.
for argument in "$@"; do
    if [[ "${argument,,}" == *.root ]] && ! command -v scram >/dev/null 2>&1; then
        cmsset_default="${CMSSET_DEFAULT:-/cvmfs/cms.cern.ch/cmsset_default.sh}"
        if [ -r "$cmsset_default" ]; then
            export VO_CMS_SW_DIR="${VO_CMS_SW_DIR:-/cvmfs/cms.cern.ch}"
            set +u
            # shellcheck disable=SC1090
            source "$cmsset_default"
            set -u
        fi
        break
    fi
done
exec "$python_bin" "$project_root/viewer_cli.py" "$@"
